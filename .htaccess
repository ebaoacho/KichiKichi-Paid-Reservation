# ----------------------------------------------------------------
# Deny direct HTTP access to sensitive files in this plugin.
# ----------------------------------------------------------------

# Block .env files (secrets)
<FilesMatch "^\.env(\..*)?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block PHP infrastructure files from direct access
<FilesMatch "^(class-kkpay-env-loader|class-kkpay-smtp-mailer|class-kkpay-stripe-config|class-kkpay-email-config)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
